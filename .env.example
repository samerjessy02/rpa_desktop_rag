# OpenRouter powers both the planner LLM (Llama-4 Scout)
OPENROUTER_API_KEY=sk-or-...

# Model ids (override if OpenRouter renames/deprecates a free tier slug)
PLANNER_MODEL=meta-llama/llama-4-scout:free

# Optional: point VISION_MODEL calls at a local Qwen2.5-VL server instead
# (e.g. served via vLLM/Ollama) by setting this to an OpenAI-compatible URL.
# If unset, the vision client also calls OpenRouter.
LOCAL_VLM_BASE_URL=
VISION_MODEL=
GOOGLE_API_KEY=
